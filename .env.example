# Configuration reference. Copy to .env and fill in the required fields.
# Empty values have no fixed default; comments explain any dynamic fallback.
# This file lists current settings only. Deprecated compatibility aliases are omitted.
# Credentials are intentionally empty. Never commit .env with real keys.

# Ingestion source

# Source identifier; no default. Required by npm run ingest; also the namespace fallback.
SOURCE_ID=
# Source title; no default. Used as the store name when AUTO_VECTOR_STORE_NAME is empty.
SOURCE_TITLE=
# HTTP(S) source URL; no default. Required by npm run ingest.
SOURCE_URL=
# auto | website | github-repository. auto recognizes GitHub repository/tree/blob URLs.
SOURCE_PROFILE=auto
# Empty: SOURCE_ID in ingest; standalone report uploads prefer the saved namespace, then SOURCE_ID.
AUTO_KB_NAMESPACE=
# Empty: SOURCE_TITLE in ingest; standalone upload uses the saved name, collection or namespace.
AUTO_VECTOR_STORE_NAME=

# Vector store provider and connection

# weaviate | qdrant | openai-compatible | custom. openai is also accepted.
# If absent: custom when an adapter module is set; otherwise openai-compatible.
AUTO_VECTOR_STORE_PROVIDER=openai-compatible
# Main storage API URL; no generic default. Required for Weaviate/Qdrant. Not an embedding-service URL.
AUTO_VECTOR_STORE_BASE_URL=
# Storage API key; no default. The official OpenAI endpoint may fall back to OPENAI_API_KEY.
AUTO_VECTOR_STORE_API_KEY=
# Weaviate/Qdrant collection; no default. Weaviate requires an uppercase initial, then letters/digits/underscore.
AUTO_VECTOR_STORE_COLLECTION=
# Optional .ts/.mjs module exporting vectorStoreAdapter or createVectorStoreAdapter(configuration).
# Empty: bundled OpenAI adapter. Built-in weaviate/qdrant take precedence over this module.
AUTO_VECTOR_STORE_ADAPTER_MODULE=
# Storage request timeout in milliseconds; integer >= 1.
AUTO_VECTOR_STORE_TIMEOUT_MS=30000
# Objects per batch in shared configuration; integer from 1 to 200.
AUTO_VECTOR_STORE_BATCH_SIZE=100
# Maximum chunks in Weaviate/Qdrant file ingestion, checked before embedding requests; integer >= 1.
AUTO_VECTOR_STORE_MAX_CHUNKS=10000
# Local chunk size in Weaviate/Qdrant adapters; integer >= 1 characters, not tokens.
AUTO_VECTOR_STORE_MAX_CHUNK_CHARACTERS=6400
# Attempts to verify persisted payloads and vectors; integer from 1 to 10.
AUTO_VECTOR_STORE_VERIFICATION_ATTEMPTS=3
# Delay between verification attempts in milliseconds; integer from 0 to 10000.
AUTO_VECTOR_STORE_VERIFICATION_DELAY_MS=250

# Embeddings

# native | provided. native: Weaviate Cloud/Qdrant Cloud generate vectors during import.
# provided: host-generated vectors in the Qdrant file adapter; Weaviate uses the precomputed-vector facade.
# If absent, an embedding module selects provided; the explicit value below overrides that selection.
AUTO_EMBEDDING_MODE=native
# No generic default. Native Weaviate defaults to Snowflake/snowflake-arctic-embed-l-v2.0.
# Native Qdrant requires a model enabled in the cluster's Inference tab; provided delegates to the host module.
AUTO_EMBEDDING_MODEL=
# Integer >= 1; no default. Required for native Qdrant; provided may infer embeddingProvider.dimensions.
AUTO_EMBEDDING_DIMENSIONS=
# External embedding-service URL; no default. Passed to provided modules; also supports Weaviate's native vectorizer URL.
# Native Qdrant uses cluster Cloud Inference and rejects an external URL here.
AUTO_EMBEDDING_BASE_URL=
# External embedding-service key; no default. Passed to provided modules; native embeddings use the cluster key.
AUTO_EMBEDDING_API_KEY=
# Optional .ts/.mjs module exporting embeddingProvider or createEmbeddingProvider(configuration).
# Required for provided mode in the runner; the library API also accepts direct EmbeddingProvider injection.
AUTO_EMBEDDING_PROVIDER_MODULE=
# Qdrant collection metric: Cosine | Dot | Euclid | Manhattan. Must match an existing collection.
QDRANT_DISTANCE=Cosine

# Discovery, acquisition and budgets

# Maximum discovered URLs/pages in the runner; integer from 1 to 100.
AUTO_MAX_PAGES=100
# Maximum conventional crawl depth; integer from 0 to 8.
AUTO_MAX_DEPTH=4
# Conventional discovery concurrency; integer from 1 to 32.
AUTO_CRAWL_CONCURRENCY=4
# Document acquisition/materialization concurrency; integer from 1 to 32.
AUTO_MATERIALIZATION_CONCURRENCY=4
# Materialization failures tolerated before skipping upload; integer >= 0. Zero requires no failures.
AUTO_MAX_FAILURES=10
# Overall ingestion deadline in milliseconds; integer >= 1. Standalone upload fallback when no upload-specific deadline is set.
AUTO_MAX_ELAPSED_MS=600000
# Standalone upload/resume deadline in milliseconds; integer >= 1.
# Precedence: this value > AUTO_MAX_ELAPSED_MS when set > 3600000 when both variables are absent.
AUTO_UPLOAD_MAX_ELAPSED_MS=3600000
# Page/acquisition request timeout in milliseconds; integer >= 1.
AUTO_PAGE_TIMEOUT_MS=30000
# Bytes per document; integer >= 1. Ingest default: 10485760 (10 MiB).
# If absent, standalone upload defaults to 5242880 (5 MiB); setting this value applies it to both commands.
AUTO_MAX_BYTES_PER_DOCUMENT=10485760
# Maximum source documents before splitting; integer >= 1.
AUTO_MAX_KB_FILES=100
# Maximum generated files after splitting; integer >= 1. Also limits loading an already-split manifest.
AUTO_MAX_SPLIT_FILES=10000
# Markdown byte limit before and after splitting; integer >= 1. 52428800 = 50 MiB.
AUTO_MAX_KB_BYTES=52428800
# Upload concurrency passed to the adapter by ingest and upload:vector-store; integer from 1 to 32.
# Bounds both Files uploads and individual OpenAI file-attachment requests; not the batch endpoint.
AUTO_UPLOAD_CONCURRENCY=4

# Local/semantic splitter

# Optional .ts/.mjs module exporting markdownSplitter or createMarkdownSplitter(); empty selects local structural splitting.
AUTO_MARKDOWN_SPLITTER_MODULE=
# Characters per structural segment in the runner/upload; integer >= 1. This is not an exact token limit.
AUTO_SPLITTER_MAX_CHARS=6400
# Maximum collection input characters before invoking the splitter; integer >= 1.
AUTO_SPLITTER_MAX_INPUT_CHARACTERS=3000000

# Semantic metadata

# local | model. local makes no model calls; model uses the selected enricher and a content cache.
AUTO_METADATA_MODE=local
# Model used by the default OpenAI metadata enricher in model mode; custom modules may interpret this differently.
AUTO_METADATA_MODEL=gpt-6-luna
# Enrichment concurrency; integer from 1 to 16.
AUTO_METADATA_CONCURRENCY=2
# Maximum uncached files before model requests; integer >= 0. Zero prevents new requests.
AUTO_METADATA_MAX_REQUESTS=100
# Maximum estimated input characters before model requests; integer >= 0. This is not a monetary cap.
AUTO_METADATA_MAX_INPUT_CHARS=3000000
# Maximum Markdown characters per file in the default OpenAI enricher; integer >= 1000.
AUTO_METADATA_MAX_CHARS=30000
# Optional module exporting metadataEnricher or createMetadataEnricher().
# Empty uses ../3_benchmarks/realtime-compare-mcp-x-function/MarkdownSplitter/openai-metadata-enricher.ts.
AUTO_METADATA_ENRICHER_MODULE=

# Token chunking for adapters that support it, including OpenAI

# Tokens per chunk in ingest and upload:vector-store; OpenAI requires an integer from 100 to 4096.
# Weaviate/Qdrant use local character-based splitting and do not use this option.
AUTO_MAX_CHUNK_SIZE_TOKENS=1600
# Overlap in tokens; integer >= 0 and <= half of AUTO_MAX_CHUNK_SIZE_TOKENS for OpenAI.
# Both commands send 200 by default; direct helper calls without chunking options default to 100.
AUTO_CHUNK_OVERLAP_TOKENS=200

# GitHub repository files, without sitemaps or social pages

# Contents-read token; no default. Optional for public repositories, required for private ones.
GITHUB_TOKEN=
# Branch, tag or SHA; empty resolves the tree/blob URL reference or the repository's default branch.
GITHUB_REF=
# Repository-relative file/directory path; empty uses the URL scope or repository root.
GITHUB_PATH=
# Comma-separated include globs, e.g. README.md,docs/**; empty permits all eligible paths.
GITHUB_INCLUDE=
# Comma-separated exclude globs, e.g. docs/archive/**; empty adds no user exclusions.
GITHUB_EXCLUDE=
# false | true. true includes source-code extensions; binary/generated/dependency exclusions still apply.
GITHUB_INCLUDE_CODE=false
# Maximum GitHub files; integer >= 1. If absent, uses AUTO_MAX_PAGES, which also caps the selected files.
GITHUB_MAX_FILES=100
# Bytes per GitHub file; integer >= 1. 5242880 = 5 MiB; also capped by the materializer.
GITHUB_MAX_FILE_BYTES=5242880
# GitHub API request budget, including enumeration and reserved downloads; integer >= 1.
GITHUB_MAX_API_REQUESTS=200
# Maximum enumeration/API response bytes; integer >= 1. 16777216 = 16 MiB.
GITHUB_MAX_API_RESPONSE_BYTES=16777216
# Maximum Git tree entries; integer >= 1. Limits/truncation produce a partial snapshot.
GITHUB_MAX_TREE_ENTRIES=100000

# OpenAI

# No default. Active key for the OpenAI metadata enricher and fallback for the official Vector Store endpoint.
OPENAI_API_KEY=
