OPENAI_API_KEY=openai-api-key
AUTO_VECTOR_STORE_API_KEY=
AUTO_VECTOR_STORE_BASE_URL=https://your-cluster.weaviate.cloud
AUTO_VECTOR_STORE_COLLECTION=KnowledgeChunks
AUTO_VECTOR_STORE_ADAPTER_MODULE=
AUTO_MAX_PAGES=100
AUTO_MAX_KB_FILES=100
AUTO_MAX_SPLIT_FILES=10000
AUTO_MAX_KB_BYTES=52428800
AUTO_MAX_DEPTH=4
AUTO_CRAWL_CONCURRENCY=4
AUTO_MATERIALIZATION_CONCURRENCY=4
SOURCE_TITLE=Increso
SOURCE_ID=increso
SOURCE_URL=https://www.increso.it

# Common connection settings for weaviate, qdrant, openai-compatible or custom.
# Keep credentials in .env, never in source control.
AUTO_VECTOR_STORE_PROVIDER=weaviate
AUTO_VECTOR_STORE_TIMEOUT_MS=30000
AUTO_VECTOR_STORE_BATCH_SIZE=100
AUTO_VECTOR_STORE_MAX_CHUNK_CHARACTERS=6400
AUTO_VECTOR_STORE_MAX_CHUNKS=10000

# Embedding service configuration is separate from vector database connection.
# Native Qdrant requires an enabled Cloud Inference model and explicit dimensions.
AUTO_EMBEDDING_MODE=native
AUTO_EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0
AUTO_EMBEDDING_DIMENSIONS=
AUTO_EMBEDDING_BASE_URL=
AUTO_EMBEDDING_API_KEY=
AUTO_EMBEDDING_PROVIDER_MODULE=
# Provider-specific Qdrant metric (Cosine, Dot, Euclid or Manhattan).
# QDRANT_DISTANCE=Cosine
# Legacy WEAVIATE_URL/API_KEY/COLLECTION and QDRANT_URL/API_KEY/COLLECTION
# are fallback aliases. Nonempty AUTO_* values always take precedence.

# Optional host module exporting markdownSplitter or createMarkdownSplitter().
AUTO_MARKDOWN_SPLITTER_MODULE=
AUTO_SPLITTER_MAX_CHARS=6400
AUTO_SPLITTER_MAX_INPUT_CHARACTERS=3000000

# Confirm persisted objects and embeddings after upload.
AUTO_VECTOR_STORE_VERIFICATION_ATTEMPTS=3
AUTO_VECTOR_STORE_VERIFICATION_DELAY_MS=250

# GitHub repository-file acquisition; auto recognizes repository/tree/blob URLs.
SOURCE_PROFILE=auto
GITHUB_TOKEN=
GITHUB_REF=
GITHUB_PATH=
GITHUB_INCLUDE=
GITHUB_EXCLUDE=
GITHUB_INCLUDE_CODE=false
GITHUB_MAX_FILES=100
GITHUB_MAX_FILE_BYTES=5242880
GITHUB_MAX_API_REQUESTS=200
GITHUB_MAX_API_RESPONSE_BYTES=16777216
GITHUB_MAX_TREE_ENTRIES=100000
