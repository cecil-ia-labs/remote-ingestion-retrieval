OPENAI_API_KEY=openai-api-key
AUTO_VECTOR_STORE_API_KEY=openai-api-key
AUTO_VECTOR_STORE_BASE_URL=
AUTO_VECTOR_STORE_ADAPTER_MODULE=
AUTO_MAX_PAGES=100
AUTO_MAX_DEPTH=4
AUTO_CRAWL_CONCURRENCY=4
AUTO_MATERIALIZATION_CONCURRENCY=4
SOURCE_TITLE=Increso
SOURCE_ID=increso
SOURCE_URL=https://www.increso.it

# Weaviate Cloud (native embeddings) or an explicit custom adapter module.
# Keep credentials in .env, never in source control.
AUTO_VECTOR_STORE_PROVIDER=weaviate
WEAVIATE_URL=https://your-cluster.weaviate.cloud
WEAVIATE_API_KEY=
WEAVIATE_COLLECTION=KnowledgeChunks
WEAVIATE_EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0
WEAVIATE_TIMEOUT_MS=30000
WEAVIATE_BATCH_SIZE=100
WEAVIATE_MAX_CHUNK_CHARACTERS=6400

# Optional host module exporting markdownSplitter or createMarkdownSplitter().
AUTO_MARKDOWN_SPLITTER_MODULE=
AUTO_SPLITTER_MAX_CHARS=6400
AUTO_SPLITTER_MAX_INPUT_CHARACTERS=3000000

# Confirm persisted objects and embeddings after upload.
WEAVIATE_VERIFICATION_ATTEMPTS=3
WEAVIATE_VERIFICATION_DELAY_MS=250
WEAVIATE_MAX_CHUNKS=10000

# GitHub repository-file acquisition; auto recognizes repository/tree/blob URLs.
SOURCE_PROFILE=auto
GITHUB_TOKEN=
GITHUB_REF=
GITHUB_PATH=
GITHUB_INCLUDE=
GITHUB_EXCLUDE=
GITHUB_INCLUDE_CODE=false
GITHUB_MAX_FILES=100
GITHUB_MAX_FILE_BYTES=5242880
GITHUB_MAX_API_REQUESTS=200
GITHUB_MAX_API_RESPONSE_BYTES=16777216
GITHUB_MAX_TREE_ENTRIES=100000
