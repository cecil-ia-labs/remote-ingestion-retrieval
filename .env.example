# Referência de configuração. Copie para .env e preencha os campos obrigatórios.
# Campos vazios não têm um valor fixo: o comentário informa o fallback dinâmico.
# Valores AUTO_* não vazios prevalecem sobre aliases WEAVIATE_*/QDRANT_* do provider selecionado.
# Credenciais ficam vazias de propósito. Nunca versione seu .env com chaves reais.

# Fonte de ingestão

# Identificador da fonte; sem padrão. Obrigatório em npm run ingest; também é fallback de namespace.
SOURCE_ID=
# Título da fonte; sem padrão. Usado como nome da Vector Store quando AUTO_VECTOR_STORE_NAME está vazio.
SOURCE_TITLE=
# URL HTTP(S) da fonte; sem padrão. Obrigatória em npm run ingest.
SOURCE_URL=
# Perfil: auto | website | github-repository. auto reconhece URLs de repositório/tree/blob do GitHub.
SOURCE_PROFILE=auto
# Namespace; vazio usa SOURCE_ID no ingest. Upload por relatório usa primeiro o namespace salvo, depois SOURCE_ID.
AUTO_KB_NAMESPACE=
# Nome da base; vazio usa SOURCE_TITLE no ingest. No upload: nome salvo no relatório, collection ou namespace.
AUTO_VECTOR_STORE_NAME=

# Provider e conexão do armazenamento

# weaviate | qdrant | openai-compatible | custom; openai é alias de openai-compatible.
# Sem esta variável: custom quando há módulo explícito; caso contrário, openai-compatible.
AUTO_VECTOR_STORE_PROVIDER=openai-compatible
# URL principal do armazenamento; sem padrão genérico. Obrigatória para Weaviate/Qdrant.
# Não é a URL de um serviço externo de embeddings. O módulo OpenAI também aceita esta configuração e mantém aliases AAC_AUTO_* abaixo.
AUTO_VECTOR_STORE_BASE_URL=
# Chave do armazenamento; sem padrão. Fallback para a chave do provider selecionado; o endpoint oficial OpenAI também usa OPENAI_API_KEY.
AUTO_VECTOR_STORE_API_KEY=
# Collection de Weaviate/Qdrant; sem padrão. Weaviate exige inicial maiúscula e letras, números ou underscore.
AUTO_VECTOR_STORE_COLLECTION=
# Caminho .ts/.mjs do módulo customizado; exporta vectorStoreAdapter ou createVectorStoreAdapter(configuration).
# Vazio no fallback OpenAI usa o adapter incluído em src/knowledge/openai-vector-store.adapter.ts.
# Providers integrados weaviate/qdrant têm precedência sobre este módulo.
AUTO_VECTOR_STORE_ADAPTER_MODULE=
# Timeout por requisição ao armazenamento, em ms; inteiro >= 1.
AUTO_VECTOR_STORE_TIMEOUT_MS=30000
# Objetos por lote na configuração comum; inteiro de 1 a 200.
AUTO_VECTOR_STORE_BATCH_SIZE=100
# Máximo de chunks na importação Weaviate/Qdrant, antes de chamadas de embeddings; inteiro >= 1.
AUTO_VECTOR_STORE_MAX_CHUNKS=10000
# Limite local de caracteres por chunk nos adapters Weaviate/Qdrant; inteiro >= 1. Não equivale a tokens.
AUTO_VECTOR_STORE_MAX_CHUNK_CHARACTERS=6400
# Tentativas de confirmação de payload e vetores persistidos; inteiro de 1 a 10.
AUTO_VECTOR_STORE_VERIFICATION_ATTEMPTS=3
# Intervalo entre tentativas de confirmação, em ms; inteiro de 0 a 10000.
AUTO_VECTOR_STORE_VERIFICATION_DELAY_MS=250

# Embeddings

# native | provided. native: o cluster Weaviate Cloud/Qdrant Cloud gera os vetores na importação.
# provided: o host gera os vetores; disponível no adapter de arquivos Qdrant. Weaviate fornecido pelo host usa a fachada incremental.
# Sem esta variável, um AUTO_EMBEDDING_PROVIDER_MODULE definido seleciona provided; o valor explícito abaixo prevalece.
AUTO_EMBEDDING_MODE=native
# Modelo; sem padrão genérico. Weaviate nativo usa Snowflake/snowflake-arctic-embed-l-v2.0 quando nenhum modelo é informado.
# Qdrant nativo exige um modelo habilitado na aba Inference do cluster; provided delega ao módulo do host.
AUTO_EMBEDDING_MODEL=
# Dimensões; inteiro >= 1, sem padrão. Obrigatórias no Qdrant nativo; provided pode inferir embeddingProvider.dimensions.
AUTO_EMBEDDING_DIMENSIONS=
# URL do serviço externo de embeddings; sem padrão. Enviada ao módulo provided; Weaviate nativo também aceita como URL do vectorizer.
# Qdrant native usa o próprio Cloud Inference e rejeita uma URL externa neste campo.
AUTO_EMBEDDING_BASE_URL=
# Chave do serviço externo de embeddings; sem padrão, enviada ao módulo provided. Native usa a chave do cluster.
AUTO_EMBEDDING_API_KEY=
# Caminho .ts/.mjs do módulo do host; exporta embeddingProvider ou createEmbeddingProvider(configuration).
# Sem padrão. Necessário para provided no runner; a API também aceita injeção direta de EmbeddingProvider.
AUTO_EMBEDDING_PROVIDER_MODULE=
# Métrica específica do Qdrant: Cosine | Dot | Euclid | Manhattan. Deve corresponder à collection existente.
QDRANT_DISTANCE=Cosine

# Descoberta, aquisição e orçamentos

# Máximo de URLs/páginas descobertas pelo runner; inteiro de 1 a 100.
AUTO_MAX_PAGES=100
# Profundidade máxima do crawl convencional; inteiro de 0 a 8.
AUTO_MAX_DEPTH=4
# Concorrência da descoberta convencional; inteiro de 1 a 32.
AUTO_CRAWL_CONCURRENCY=4
# Concorrência da aquisição/materialização de documentos; inteiro de 1 a 32.
AUTO_MATERIALIZATION_CONCURRENCY=4
# Falhas de materialização toleradas antes de pular o upload; inteiro >= 0. Zero exige nenhuma falha.
AUTO_MAX_FAILURES=10
# Prazo total da execução, em ms; inteiro >= 1. Também se aplica ao upload isolado.
AUTO_MAX_ELAPSED_MS=600000
# Timeout por página/requisição de aquisição, em ms; inteiro >= 1.
AUTO_PAGE_TIMEOUT_MS=30000
# Bytes por documento; inteiro >= 1. Padrão do ingest: 10485760 (10 MiB).
# Quando ausente, upload isolado usa 5242880 (5 MiB); definir este valor aplica o mesmo teto aos dois comandos.
AUTO_MAX_BYTES_PER_DOCUMENT=10485760
# Máximo de documentos de origem, antes do splitter; inteiro >= 1.
AUTO_MAX_KB_FILES=100
# Máximo de arquivos gerados após o splitter; inteiro >= 1. Também limita a leitura de um manifest já dividido.
AUTO_MAX_SPLIT_FILES=10000
# Teto de bytes do Markdown da base, conferido antes e após a divisão; inteiro >= 1. 52428800 = 50 MiB.
AUTO_MAX_KB_BYTES=52428800
# Concorrência de upload enviada por ingest e upload:vector-store ao adapter; inteiro de 1 a 32.
AUTO_UPLOAD_CONCURRENCY=4

# Splitter local/semântico

# Módulo .ts/.mjs que exporta markdownSplitter ou createMarkdownSplitter(); vazio seleciona o splitter estrutural local.
AUTO_MARKDOWN_SPLITTER_MODULE=
# Caracteres por segmento no splitter estrutural do runner/upload; inteiro >= 1. Não garante uma contagem de tokens.
AUTO_SPLITTER_MAX_CHARS=6400
# Máximo de caracteres de entrada da coleção antes de executar o splitter; inteiro >= 1.
AUTO_SPLITTER_MAX_INPUT_CHARACTERS=3000000

# Metadados semânticos

# local | model. local não chama modelos; model usa o enricher selecionado e cache por conteúdo.
AUTO_METADATA_MODE=local
# Modelo do enricher OpenAI legado quando AUTO_METADATA_MODE=model; módulos próprios podem interpretar de outra forma.
AUTO_METADATA_MODEL=gpt-6-luna
# Concorrência do enriquecimento; inteiro de 1 a 16.
AUTO_METADATA_CONCURRENCY=2
# Máximo de arquivos não cobertos pelo cache antes de chamadas de modelo; inteiro >= 0. Zero proíbe novas chamadas.
AUTO_METADATA_MAX_REQUESTS=100
# Máximo estimado de caracteres de entrada antes de chamadas de modelo; inteiro >= 0. Não é um teto monetário.
AUTO_METADATA_MAX_INPUT_CHARS=3000000
# Máximo de caracteres de Markdown por arquivo no enricher OpenAI legado; inteiro >= 1000.
AUTO_METADATA_MAX_CHARS=30000
# Módulo que exporta metadataEnricher ou createMetadataEnricher(); sem caminho explícito usa o módulo irmão abaixo.
# Fallback: ../3_benchmarks/realtime-compare-mcp-x-function/MarkdownSplitter/openai-metadata-enricher.ts.
AUTO_METADATA_ENRICHER_MODULE=

# Chunking em tokens dos adapters que o aceitam (incluindo OpenAI legado)

# Tokens por chunk em ingest e upload:vector-store; OpenAI exige inteiro de 100 a 4096. Weaviate/Qdrant usam divisão local e ignoram esta opção.
AUTO_MAX_CHUNK_SIZE_TOKENS=1600
# Overlap de tokens em ingest e upload:vector-store; inteiro >= 0 e <= metade de AUTO_MAX_CHUNK_SIZE_TOKENS no OpenAI.
# Os dois comandos enviam explicitamente o padrão 200; apenas chamadas diretas ao helper legado sem opções usam 100.
AUTO_CHUNK_OVERLAP_TOKENS=200

# GitHub: aquisição de arquivos, sem sitemap nem páginas sociais

# Token de leitura de Contents; sem padrão. Opcional para repositórios públicos, necessário para privados.
GITHUB_TOKEN=
# Branch, tag ou SHA; vazio resolve a referência da URL tree/blob ou a branch padrão do repositório.
GITHUB_REF=
# Caminho de arquivo/diretório relativo ao repositório; vazio usa o escopo da URL ou a raiz.
GITHUB_PATH=
# Globs incluídos, separados por vírgula, por exemplo README.md,docs/**; vazio permite todos os caminhos elegíveis.
GITHUB_INCLUDE=
# Globs excluídos, separados por vírgula, por exemplo docs/archive/**; vazio não adiciona exclusões do usuário.
GITHUB_EXCLUDE=
# false | true. true inclui extensões de código-fonte; exclusões de binários, gerados e dependências continuam valendo.
GITHUB_INCLUDE_CODE=false
# Máximo de arquivos do GitHub; inteiro >= 1. Quando ausente, usa AUTO_MAX_PAGES; o teto de páginas também se aplica.
GITHUB_MAX_FILES=100
# Bytes por arquivo do GitHub; inteiro >= 1. 5242880 = 5 MiB; também limitado pelo materializador.
GITHUB_MAX_FILE_BYTES=5242880
# Orçamento de chamadas à API GitHub, incluindo enumeração e reserva para downloads; inteiro >= 1.
GITHUB_MAX_API_REQUESTS=200
# Bytes máximos por resposta de enumeração/API; inteiro >= 1. 16777216 = 16 MiB.
GITHUB_MAX_API_RESPONSE_BYTES=16777216
# Máximo de entradas da árvore Git; inteiro >= 1. Limites/truncamento geram snapshot parcial.
GITHUB_MAX_TREE_ENTRIES=100000

# OpenAI e aliases legados AAC_AUTO_*

# Chave OpenAI; sem padrão. Usada pelo adapter OpenAI legado e pelo enricher de metadados em modo model.
OPENAI_API_KEY=
# Alias legado da URL HTTPS de uma API Files/Vector Stores compatível. AUTO_VECTOR_STORE_BASE_URL tem precedência.
# Sem URL genérica ou legado, usa https://api.openai.com/v1; a chave genérica tem precedência sobre OPENAI_API_KEY.
AAC_AUTO_VECTOR_STORE_BASE_URL=
# Chave do endpoint compatível legado; sem padrão. Obrigatória quando a URL AAC_AUTO_* é usada sem URL genérica.
AAC_AUTO_VECTOR_STORE_API_KEY=
# Nome no relatório do endpoint compatível; vazio usa openai-compatible-vector-stores quando há URL genérica ou AAC_AUTO_*.
# Sem URL explícita, o adapter OpenAI padrão se chama openai-vector-stores.
AAC_AUTO_VECTOR_STORE_PROVIDER_NAME=

# Aliases de compatibilidade Weaviate
# Use preferencialmente AUTO_* acima. Os aliases só são consultados para o provider weaviate e quando o equivalente genérico está vazio.

# Alias de AUTO_VECTOR_STORE_BASE_URL; sem padrão. URL HTTP(S) do cluster Weaviate, opcionalmente terminando em /v1.
WEAVIATE_URL=
# Alias de AUTO_VECTOR_STORE_API_KEY; sem padrão. Chave do cluster Weaviate.
WEAVIATE_API_KEY=
# Alias de AUTO_VECTOR_STORE_COLLECTION; sem padrão. Collection dedicada, com inicial maiúscula.
WEAVIATE_COLLECTION=
# Alias de AUTO_VECTOR_STORE_TIMEOUT_MS; inteiro >= 1, em ms.
WEAVIATE_TIMEOUT_MS=30000
# Alias de AUTO_VECTOR_STORE_BATCH_SIZE; inteiro de 1 a 200 no resolver comum.
WEAVIATE_BATCH_SIZE=100
# Alias de AUTO_VECTOR_STORE_MAX_CHUNKS; inteiro >= 1.
WEAVIATE_MAX_CHUNKS=10000
# Alias de AUTO_VECTOR_STORE_MAX_CHUNK_CHARACTERS; inteiro >= 1, em caracteres.
WEAVIATE_MAX_CHUNK_CHARACTERS=6400
# Alias de AUTO_VECTOR_STORE_VERIFICATION_ATTEMPTS; inteiro de 1 a 10.
WEAVIATE_VERIFICATION_ATTEMPTS=3
# Alias de AUTO_VECTOR_STORE_VERIFICATION_DELAY_MS; inteiro de 0 a 10000, em ms.
WEAVIATE_VERIFICATION_DELAY_MS=250
# Alias de AUTO_EMBEDDING_MODEL; padrão efetivo do vectorizer nativo Weaviate quando não há modelo genérico.
WEAVIATE_EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0
# Alias de AUTO_EMBEDDING_DIMENSIONS; inteiro >= 1, sem padrão. Depende do modelo Weaviate escolhido.
WEAVIATE_EMBEDDING_DIMENSIONS=
# Alias de AUTO_EMBEDDING_BASE_URL; sem padrão. Endpoint opcional do vectorizer nativo Weaviate.
WEAVIATE_EMBEDDING_BASE_URL=

# Aliases de compatibilidade Qdrant
# Use preferencialmente AUTO_* acima. Os aliases só são consultados para o provider qdrant e quando o equivalente genérico está vazio.

# Alias de AUTO_VECTOR_STORE_BASE_URL; sem padrão. Endpoint REST do Qdrant, normalmente na porta 6333.
QDRANT_URL=
# Alias de AUTO_VECTOR_STORE_API_KEY; sem padrão. Chave do cluster Qdrant, quando exigida.
QDRANT_API_KEY=
# Alias de AUTO_VECTOR_STORE_COLLECTION; sem padrão. Nome da collection Qdrant.
QDRANT_COLLECTION=
# Alias de AUTO_VECTOR_STORE_TIMEOUT_MS; inteiro >= 1, em ms.
QDRANT_TIMEOUT_MS=30000
# Alias de AUTO_VECTOR_STORE_BATCH_SIZE; inteiro de 1 a 200 no resolver comum.
QDRANT_BATCH_SIZE=100
# Alias de AUTO_VECTOR_STORE_MAX_CHUNKS; inteiro >= 1.
QDRANT_MAX_CHUNKS=10000
# Alias de AUTO_VECTOR_STORE_MAX_CHUNK_CHARACTERS; inteiro >= 1, em caracteres.
QDRANT_MAX_CHUNK_CHARACTERS=6400
# Alias de AUTO_VECTOR_STORE_VERIFICATION_ATTEMPTS; inteiro de 1 a 10.
QDRANT_VERIFICATION_ATTEMPTS=3
# Alias de AUTO_VECTOR_STORE_VERIFICATION_DELAY_MS; inteiro de 0 a 10000, em ms.
QDRANT_VERIFICATION_DELAY_MS=250
# Alias de AUTO_EMBEDDING_MODEL; sem padrão. Qdrant nativo exige o nome exato do modelo habilitado no cluster.
QDRANT_EMBEDDING_MODEL=
# Alias de AUTO_EMBEDDING_DIMENSIONS; inteiro >= 1, sem padrão. Deve corresponder ao modelo e à collection.
QDRANT_EMBEDDING_DIMENSIONS=
# Alias de AUTO_EMBEDDING_BASE_URL; sem padrão. Disponível ao módulo provided; Qdrant native rejeita endpoint externo.
QDRANT_EMBEDDING_BASE_URL=
